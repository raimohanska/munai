{
  "name": "Munai",
  "version": "0.1.33",
  "slug": "munai",
  "description": "Recognize nest occupants and publish an MQTT device",
  "arch": ["aarch64", "amd64"],
  "stage": "experimental",
  "startup": "application",
  "boot": "manual",
  "init": true,
  "timeout": 120,
  "backup": "cold",
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:notebook-outline",
  "panel_title": "MunAI",
  "ports": {"8443/tcp": null},
  "ports_description": {"8443/tcp": "Pinned HTTPS reference transfer API (LAN/VPN only)"},
  "options": {
    "capture_enabled": false,
    "camera_url": "",
    "capture_interval": 60,
    "capture_pause_start": "23:00",
    "capture_pause_end": "05:00",
    "capture_timeout": 20,
    "expire_after": 180,
    "mqtt_enabled": false,
    "mqtt_host": "core-mosquitto",
    "mqtt_port": 1883,
    "mqtt_user": "",
    "mqtt_password": "",
    "mqtt_tls": false,
    "device_id": "munai_ha_nest",
    "device_name": "Munai nest",
    "transfer_enabled": true,
    "transfer_token_name": "desktop",
    "transfer_token_scope": "write",
    "store_captures": false,
    "capture_deduplicate": true,
    "capture_heartbeat_seconds": 900,
    "box_split": "none",
    "retention_days": 7,
    "journal_retention_days": 365,
    "capture_storage_mb": 2048,
    "minimum_free_mb": 128,
    "training_storage_mb": 512,
    "chicken_area": 4500,
    "texture_threshold": 8,
    "egg_min_area": 950,
    "egg_max_area": 3500,
    "max_distance": 1.25,
    "min_margin": 0.25,
    "log_level": "info"
  },
  "schema": {
    "capture_enabled": "bool",
    "camera_url": "password",
    "capture_interval": "int(30,86400)",
    "capture_pause_start": "match(^([01][0-9]|2[0-3]):[0-5][0-9]$)",
    "capture_pause_end": "match(^([01][0-9]|2[0-3]):[0-5][0-9]$)",
    "capture_timeout": "int(1,60)",
    "expire_after": "int(60,172800)",
    "mqtt_enabled": "bool",
    "mqtt_host": "str",
    "mqtt_port": "port",
    "mqtt_user": "str",
    "mqtt_password": "password",
    "mqtt_tls": "bool",
    "device_id": "match(^[a-zA-Z0-9_-]{1,48}$)",
    "device_name": "str",
    "transfer_enabled": "bool",
    "transfer_token_name": "str(1,80)",
    "transfer_token_scope": "list(read|write)",
    "transfer_token_sha256": "password?",
    "transfer_tokens": ["str?"],
    "store_captures": "bool",
    "capture_deduplicate": "bool",
    "capture_heartbeat_seconds": "int(60,86400)",
    "box_split": "list(none|vertical|horizontal)",
    "retention_days": "int(1,365)",
    "journal_retention_days": "int(1,3650)",
    "capture_storage_mb": "int(16,4096)",
    "minimum_free_mb": "int(64,4096)",
    "training_storage_mb": "int(16,4096)",
    "chicken_area": "int(100,100000)",
    "texture_threshold": "int(1,100)",
    "egg_min_area": "int(100,10000)",
    "egg_max_area": "int(100,10000)",
    "max_distance": "float(0.01,10)",
    "min_margin": "float(0,10)",
    "log_level": "list(info|debug)"
  }
}
