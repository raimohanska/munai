# Literal values only; no shell commands or variable expansion.
RTSP_URL=rtsp://USER:PASSWORD@CAMERA_IP:554/STREAM_PATH
CAPTURE_DIR=captures
CAPTURE_TIMEOUT_SECONDS=30
FFMPEG_PATH=/usr/bin/ffmpeg

# Compare 320x180 grayscale pixels; ignore brightness differences of 15 or less.
SIMILARITY_PIXEL_THRESHOLD=15
# Save when at least this percentage changes; 0 disables similarity filtering.
SIMILARITY_MIN_CHANGED_PERCENT=0.1

# chicken_device.py: omit CAPTURE_DIR entirely to disable persistent images.
# Placeholder broker settings; never commit real credentials.
MQTT_HOST=mqtt.example.invalid
MQTT_PORT=1883
MQTT_USER=YOUR_MQTT_USER
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_TLS=false
